  "item": [
    {
      "name": "Создать объект",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Код ответа 200\", function () {\n    pm.response.to.have.status(200);\n});\n\npm.test(\"В ответе есть id, и мы его запомнили\", function () {\n    const data = pm.response.json();\n    pm.expect(data.id).to.be.a(\"string\");\n    pm.expect(data.name).to.eql(\"Лекция CI/CD\");\n    pm.expect(data.data.price).to.eql(1000);\n    pm.collectionVariables.set(\"objectId\", data.id);\n});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Лекция CI/CD\",\n  \"data\": {\n    \"year\": 2026,\n    \"price\": 1000\n  }\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "https://api.restful-api.dev/collections/devices/objects",
          "protocol": "https",
          "host": [
